               style="mix-blend-mode: multiply;">
            <g fill="oklch(28% 0.06 170)" font-family="monospace" font-size="13" opacity="0.7" letter-spacing="1">
              <text x="60" y="60">STORYBOARD &middot; SPIKE'S FIRST EVENT</text>
            </g>
          </svg>
          <img src="../assets/mec/07-storyboard-spike.png" alt="Storyboard — Spike's journey using MEC Connect, from in-store QR scan to event arrival." onerror="this.style.display='none'">
          <span class="cs-frame__label">Storyboard &middot; Spike's first event</span>
        </div>
        <p class="cs-image__caption">
          Six-frame storyboard covering action / thought / goal at each step of Spike's
          first MEC Connect experience.
        </p>
